# ===== Server =====
PORT=3001
FRONTEND_URL=http://localhost:5173

# ===== Discord OAuth2 =====
DISCORD_CLIENT_ID=YOUR_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_CLIENT_SECRET
# ✅ callback ต้องชี้มาที่ API (เพราะเราเก็บ state/sid และแลก token ที่ API)
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# ===== Discord Bot Token (ใช้ใส่ role) =====
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN

# ===== Turnstile =====
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000AA

# ===== Postgres =====
DATABASE_URL=postgres://user:pass@localhost:5432/xerl_verify

# ===== Secret กันคนยิง endpoint สำหรับบอท =====
INTERNAL_BOT_SECRET=CHANGE_ME_SUPER_SECRET
